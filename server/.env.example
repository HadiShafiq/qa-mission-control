# QA Mission Control — server configuration
# Copy to server/.env (npm run setup does this for you). Never commit .env.

# SQLite database file, relative to server/prisma/. To use PostgreSQL later:
# DATABASE_URL="postgresql://user:password@localhost:5432/qamc"  (and change provider in schema.prisma)
DATABASE_URL="file:./dev.db"

HOST=127.0.0.1
PORT=4000

# Where uploaded documents and generated artifacts are stored (relative to server/).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Frontend origin allowed to call the API in development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=info

# AI (CR Analyst, Phase 2+). Get a key at console.anthropic.com. Without it the
# app shows "AI not connected" and never produces AI results.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher is more thorough and uses more tokens.
AI_EFFORT=high
# Budget per request. Over-budget input is refused (documents are never truncated).
AI_MAX_INPUT_TOKENS=300000
AI_MAX_OUTPUT_TOKENS=64000
# The SDK retries rate limits, overload and network errors this many times.
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=900
